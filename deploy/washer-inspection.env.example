INSPECTION_ENGINE=/opt/washer-inspection/models/washer_yolov8n_fp16.engine
INSPECTION_SERIAL=/dev/ttyTHS1
INSPECTION_BAUD=115200
INSPECTION_CAMERA=0
INSPECTION_CONFIDENCE=0.45
INSPECTION_IOU=0.45
INSPECTION_CLASS_NAMES=notch,deformation
INSPECTION_DEFECT_CLASS_IDS=0,1
INSPECTION_SHOW_WINDOW=0
INSPECTION_DEBUG_UART=0
# 心跳与链路监控:Jetson 每秒向 STM32 发送 HEARTBEAT(AUX 携带 RX 校验错误数),
# 并检测 MCU 静默(stm32_silent 事件);STM32 侧回复 ACK 并用它判定视觉存活。
INSPECTION_HEARTBEAT_PERIOD_S=1.0
INSPECTION_LINK_SILENT_TIMEOUT_S=5.0
# 缺陷图留存:缺口/变形/视觉异常帧后台线程 JPEG 落盘,文件名含时间戳+序号+结果码。
INSPECTION_SAVE_IMAGES=1
INSPECTION_SAVE_ERROR_IMAGES=1
INSPECTION_IMAGE_DIR=/var/lib/washer-inspection/defect_images
